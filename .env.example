# Frontend environment variables
# Set these in your hosting platform or copy to .env.local for local development

# Base backend/public URL (no trailing slash)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# API base URL (if your API is exposed under /api). If not set, it will be derived from NEXT_PUBLIC_BACKEND_URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api
